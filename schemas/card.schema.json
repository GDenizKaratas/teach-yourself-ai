{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teach/card.schema.json",
  "title": "Card: one line of tracks/<track>/cards.jsonl",
  "description": "Written only by `tools/learn add-card` (validated, options shuffled, id assigned) and rewritten by `record` (srs) and `retire`. Unknown fields are allowed and kept; readers ignore what they don't know.",
  "type": "object",
  "required": ["id", "track", "node", "type", "prompt", "explanation", "created", "srs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]+$", "description": "track prefix + number, e.g. pts-001; unique across tracks"},
    "track": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "node": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "a node id of the track's map.md"},
    "type": {"enum": ["mcq", "predict-output", "spot-the-bug", "recall", "explain"]},
    "prompt": {"type": "string", "minLength": 1},
    "code": {"type": "string"},
    "options": {
      "type": "array", "minItems": 2, "maxItems": 4,
      "description": "mcq / predict-output / spot-the-bug only, in the stored (shuffled) order; exactly one correct; every distractor names its misconception",
      "items": {
        "type": "object", "required": ["text"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "correct": {"const": true},
          "misconception": {"type": "string", "pattern": "^m-[a-z0-9-]+$"}
        }
      }
    },
    "answer": {"type": "string", "description": "reference answer; required for recall / explain"},
    "explanation": {"type": "string", "minLength": 1},
    "cue": {"enum": ["lesson", "adjacent", "far"]},
    "mode": {"enum": ["recall", "discriminate", "compose"]},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "srs": {
      "type": "object", "required": ["due", "interval", "ease", "reps", "lapses"],
      "properties": {
        "due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "interval": {"type": "integer", "minimum": 0},
        "ease": {"type": "number"},
        "reps": {"type": "integer", "minimum": 0},
        "lapses": {"type": "integer", "minimum": 0},
        "last": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "absent = never asked"}
      }
    },
    "retired": {
      "type": "object", "required": ["on", "reason"],
      "properties": {"on": {"type": "string"}, "reason": {"type": "string"}}
    }
  }
}
